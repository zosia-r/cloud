    {
      "name": "2. Testy negatywne — walidacja danych",
      "item": [
        {
          "name": "NEG-1 Brak wymaganych pól przy tworzeniu zamówienia → 422",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[NEG-1] Status 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
            "pm.test('[NEG-1] Response zawiera informację o błędzie walidacji', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json).to.have.property('detail');",
            "    pm.expect(json.detail).to.be.an('array').and.not.empty;",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{order_service_url}}/orders/"
          }
        },
        {
          "name": "NEG-2 Pobranie nieistniejącego zamówienia → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[NEG-2] Status 404 Not Found', () => pm.response.to.have.status(404));",
            "pm.test('[NEG-2] Response zawiera opis błędu', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json).to.have.property('detail');",
            "    pm.expect(json.detail).to.be.a('string').and.not.empty;",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{order_service_url}}/orders/nieistniejace-id-00000" }
        },
        {
          "name": "NEG-3 Płatność bez wymaganych pól → 422",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[NEG-3] Status 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
            "pm.test('[NEG-3] Response zawiera detail z błędem walidacji', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json).to.have.property('detail');",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"currency\": \"PLN\" }" },
            "url": "{{payment_service_url}}/payments/"
          }
        },
        {
          "name": "NEG-4 Płatność dla nieistniejącego zamówienia → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[NEG-4] Status 404 Not Found', () => pm.response.to.have.status(404));",
            "pm.test('[NEG-4] Response zawiera opis błędu', () => {",
            "    pm.expect(pm.response.json()).to.have.property('detail');",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{payment_service_url}}/payments/order/nieistniejace-id-00000"
          }
        }
      ]
    },

    {
      "name": "3. Pełny flow zamówienia (end-to-end)",
      "item": [
        {
          "name": "FLOW-1 Utwórz zamówienie (status=pending)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Generuj unikalny email żeby uniknąć kolizji przy wielokrotnym uruchomieniu",
                "const timestamp = Date.now();",
                "pm.collectionVariables.set('customer_email', `klient_${timestamp}@example.com`);",
                "pm.collectionVariables.set('product_desc', 'Tort urodzinowy czekoladowy z dekoracjami');"
              ], "type": "text/javascript" }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('[FLOW-1] Status 201 Created', () => pm.response.to.have.status(201));",
                "pm.test('[FLOW-1] Response zawiera order_id (UUID)', () => {",
                "    const json = pm.response.json();",
                "    pm.expect(json).to.have.property('order_id');",
                "    pm.expect(json.order_id).to.match(/^[0-9a-f-]{36}$/);",
                "    pm.collectionVariables.set('order_id', json.order_id);",
                "    console.log('Zapisano order_id:', json.order_id);",
                "});",
                "pm.test('[FLOW-1] Nowe zamówienie ma status pending', () => {",
                "    pm.expect(pm.response.json().status).to.eql('pending');",
                "});",
                "pm.test('[FLOW-1] Content-Type to application/json', () => {",
                "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                "});"
              ], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Anna Kowalska\",\n  \"customer_email\": \"{{customer_email}}\",\n  \"product_description\": \"{{product_desc}}\",\n  \"quantity\": 2\n}"
            },
            "url": "{{order_service_url}}/orders/"
          }
        },

        {
          "name": "FLOW-2 Pobierz zamówienie — dane zgodne z wysłanymi",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-2] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-2] ID zamówienia zgadza się', () => {",
            "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('order_id'));",
            "});",
            "pm.test('[FLOW-2] Dane klienta są poprawne', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.customer_name).to.eql('Anna Kowalska');",
            "    pm.expect(json.quantity).to.eql(2);",
            "});",
            "pm.test('[FLOW-2] Zamówienie posiada datę created_at', () => {",
            "    pm.expect(pm.response.json()).to.have.property('created_at');",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{order_service_url}}/orders/{{order_id}}" }
        },

        {
          "name": "FLOW-3 Lista zamówień zawiera nowe zamówienie",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-3] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-3] Response jest tablicą', () => {",
            "    pm.expect(pm.response.json()).to.be.an('array');",
            "});",
            "pm.test('[FLOW-3] Lista zawiera nowo utworzone zamówienie', () => {",
            "    const orders = pm.response.json();",
            "    const found = orders.find(o => o.id === pm.collectionVariables.get('order_id'));",
            "    pm.expect(found).to.not.be.undefined;",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{order_service_url}}/orders/" }
        },

        {
          "name": "FLOW-4 Wgraj plik graficzny (DesignService)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Tworzymy plik PNG jako base64 bezpośrednio w skrypcie",
                "// 1x1 piksel PNG (minimalny poprawny plik PNG)",
                "const base64PNG = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==';",
                "pm.collectionVariables.set('test_file_base64', base64PNG);"
              ], "type": "text/javascript" }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('[FLOW-4] Status 201 Created', () => pm.response.to.have.status(201));",
                "pm.test('[FLOW-4] Response zawiera design_id', () => {",
                "    const json = pm.response.json();",
                "    pm.expect(json).to.have.property('design_id');",
                "    pm.expect(json.design_id).to.be.a('string').and.not.empty;",
                "    pm.collectionVariables.set('design_id', json.design_id);",
                "});",
                "pm.test('[FLOW-4] Rozszerzenie pliku zostało zapisane w logach', () => {",
                "    const json = pm.response.json();",
                "    pm.expect(json).to.have.property('extension');",
                "    pm.expect(json.extension).to.be.a('string').and.not.empty;",
                "});",
                "pm.test('[FLOW-4] Nazwa pliku została zapisana', () => {",
                "    pm.expect(pm.response.json()).to.have.property('filename');",
                "});",
                "pm.test('[FLOW-4] order_id w odpowiedzi zgadza się', () => {",
                "    pm.expect(pm.response.json().order_id).to.eql(pm.collectionVariables.get('order_id'));",
                "});"
              ], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "order_id", "value": "{{order_id}}", "type": "text" },
                { "key": "file", "type": "file", "src": [],
                  "description": "Wybierz dowolny plik graficzny z komputera" }
              ]
            },
            "url": "{{design_service_url}}/designs/upload"
          }
        },

        {
          "name": "FLOW-5 Plik graficzny widoczny w DesignService",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-5] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-5] Lista zawiera wgrany plik', () => {",
            "    const files = pm.response.json();",
            "    pm.expect(files).to.be.an('array');",
            "    const found = files.find(f => f.id === pm.collectionVariables.get('design_id'));",
            "    pm.expect(found).to.not.be.undefined;",
            "});",
            "pm.test('[FLOW-5] Plik ma zapisane rozszerzenie', () => {",
            "    const files = pm.response.json();",
            "    const found = files.find(f => f.id === pm.collectionVariables.get('design_id'));",
            "    pm.expect(found.extension).to.be.a('string').and.not.empty;",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{design_service_url}}/designs/?order_id={{order_id}}",
              "host": ["{{design_service_url}}"],
              "path": ["designs", ""],
              "query": [{ "key": "order_id", "value": "{{order_id}}" }]
            }
          }
        },

        {
          "name": "FLOW-6 Stan magazynu przed rezerwacją",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-6] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-6] Magazyn zawiera składniki', () => {",
            "    const items = pm.response.json();",
            "    pm.expect(items).to.be.an('array').and.not.empty;",
            "});",
            "pm.test('[FLOW-6] Każdy składnik ma name i quantity', () => {",
            "    pm.response.json().forEach(item => {",
            "        pm.expect(item).to.have.property('name');",
            "        pm.expect(item).to.have.property('quantity');",
            "    });",
            "});",
            "// Zapisz stan przed rezerwacją do porównania po rezerwacji",
            "pm.collectionVariables.set('inventory_before', JSON.stringify(pm.response.json()));"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{inventory_service_url}}/ingredients" }
        },

        {
          "name": "FLOW-7 Zarezerwuj składniki",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-7] Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('[FLOW-7] Rezerwacja zawiera listę składników', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json).to.have.property('reservations');",
            "    pm.expect(json.reservations).to.be.an('array').and.not.empty;",
            "});",
            "pm.test('[FLOW-7] Każda rezerwacja ma ingredient i quantity', () => {",
            "    pm.response.json().reservations.forEach(r => {",
            "        pm.expect(r).to.have.property('ingredient');",
            "        pm.expect(r).to.have.property('quantity');",
            "        pm.expect(r.quantity).to.be.above(0);",
            "    });",
            "});",
            "pm.test('[FLOW-7] order_id w odpowiedzi zgadza się', () => {",
            "    pm.expect(pm.response.json().order_id).to.eql(pm.collectionVariables.get('order_id'));",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"quantity_multiplier\": 1\n}"
            },
            "url": "{{inventory_service_url}}/reserve"
          }
        },

        {
          "name": "FLOW-8 Stan magazynu zmniejszył się po rezerwacji",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-8] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-8] Stan magazynu zmniejszył się po rezerwacji', () => {",
            "    const before = JSON.parse(pm.collectionVariables.get('inventory_before'));",
            "    const after = pm.response.json();",
            "    // Sprawdź że przynajmniej jeden składnik ma mniejszą ilość",
            "    const decreased = after.some(itemAfter => {",
            "        const itemBefore = before.find(b => b.name === itemAfter.name);",
            "        return itemBefore && itemAfter.quantity < itemBefore.quantity;",
            "    });",
            "    pm.expect(decreased).to.be.true;",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{inventory_service_url}}/ingredients" }
        },

        {
          "name": "FLOW-9 Zrealizuj płatność",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-9] Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('[FLOW-9] Płatność otrzymała status authorized', () => {",
            "    pm.expect(pm.response.json().status).to.eql('authorized');",
            "});",
            "pm.test('[FLOW-9] Kod autoryzacji istnieje i zaczyna się od AUTH-', () => {",
            "    const code = pm.response.json().authorization_code;",
            "    pm.expect(code).to.be.a('string').and.not.empty;",
            "    pm.expect(code).to.match(/^AUTH-/);",
            "});",
            "pm.test('[FLOW-9] Kwota i waluta są poprawne', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.amount).to.eql(149.99);",
            "    pm.expect(json.currency).to.eql('PLN');",
            "});",
            "pm.test('[FLOW-9] order_id w odpowiedzi zgadza się', () => {",
            "    pm.expect(pm.response.json().order_id).to.eql(pm.collectionVariables.get('order_id'));",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"amount\": 149.99,\n  \"currency\": \"PLN\"\n}"
            },
            "url": "{{payment_service_url}}/payments/"
          }
        },

        {
          "name": "FLOW-10 Pobierz płatność — dane zgodne",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-10] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-10] Płatność powiązana z właściwym zamówieniem', () => {",
            "    pm.expect(pm.response.json().order_id).to.eql(pm.collectionVariables.get('order_id'));",
            "});",
            "pm.test('[FLOW-10] Status płatności to authorized', () => {",
            "    pm.expect(pm.response.json().status).to.eql('authorized');",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{payment_service_url}}/payments/order/{{order_id}}" }
        },

        {
          "name": "FLOW-11 Aktualizuj status zamówienia na confirmed",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('[FLOW-11] Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('[FLOW-11] Status zamówienia zmieniony na confirmed', () => {",
            "    pm.expect(pm.response.json().status).to.eql('confirmed');",
            "});",
            "pm.test('[FLOW-11] ID zamówienia nie zmieniło się', () => {",
            "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('order_id'));",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}" },
            "url": "{{order_service_url}}/orders/{{order_id}}/status"
          }
        },

        {
          "name": "FLOW-12 [END-TO-END] NotificationService odebrał wiadomości z RabbitMQ",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Czekaj 2 sekundy żeby NotificationService zdążył przetworzyć wiadomości z kolejki",
                "const waitTime = 2000;",
                "console.log(`Czekam ${waitTime}ms na przetworzenie wiadomości przez NotificationService...`);",
                "setTimeout(() => {}, waitTime);"
              ], "type": "text/javascript" }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('[FLOW-12] Status 200 OK', () => pm.response.to.have.status(200));",
                "pm.test('[FLOW-12] NotificationService zapisał powiadomienia z kolejek RabbitMQ', () => {",
                "    const notifications = pm.response.json();",
                "    pm.expect(notifications).to.be.an('array').and.not.empty;",
                "    console.log('Liczba powiadomień:', notifications.length);",
                "    notifications.forEach(n => console.log(' -', n.notification_type, '|', n.message));",
                "});",
                "pm.test('[FLOW-12] Powiadomienie o złożeniu zamówienia dotarło (order.created)', () => {",
                "    const notifications = pm.response.json();",
                "    const found = notifications.find(n => n.notification_type === 'order_created');",
                "    pm.expect(found).to.not.be.undefined;",
                "    pm.expect(found.message).to.include(pm.collectionVariables.get('order_id'));",
                "});",
