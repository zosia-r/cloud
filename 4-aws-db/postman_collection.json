                  "pm.test('[DDB-NOTIF-1] Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('[DDB-NOTIF-1] Notification stored in DynamoDB with notification_id', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('id');",
                  "    pm.expect(j.order_id).to.eql(pm.collectionVariables.get('order_id'));",
                  "    pm.expect(j.recipient_email).to.eql('klient@example.com');",
                  "    pm.expect(j.notification_type).to.eql('order_confirmed');",
                  "    pm.expect(j.status).to.eql('sent');",
