    {
      "name": "2. AWS RDS — OrderService (PostgreSQL)",
      "item": [
        {
          "name": "RDS-ORDER-1 Create order (persists to RDS)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('customer_email', `klient_${Date.now()}@example.com`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RDS-ORDER-1] Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('[RDS-ORDER-1] Zwraca order_id (stored in RDS)', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('order_id');",
                  "    pm.expect(j.order_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "    pm.collectionVariables.set('order_id', j.order_id);",
                  "});",
                  "pm.test('[RDS-ORDER-1] Status pending', () => pm.expect(pm.response.json().status).to.eql('pending'));",
                  "pm.test('[RDS-ORDER-1] Zawiera customer_name i customer_email', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.customer_name).to.eql('Anna Kowalska');",
                  "    pm.expect(j.customer_email).to.eql(pm.collectionVariables.get('customer_email'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Anna Kowalska\",\n  \"customer_email\": \"{{customer_email}}\",\n  \"product_description\": \"Tort czekoladowy\",\n  \"quantity\": 2\n}"
            },
            "url": "{{order_service_url}}/orders/"
          }
        },
        {
          "name": "RDS-ORDER-2 Get order by ID (verify RDS persistence)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RDS-ORDER-2] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[RDS-ORDER-2] Retrieve existing order from RDS', () => {",
                  "    const j = pm.response.json();",
                  "    const storedOrderId = pm.collectionVariables.get('order_id');",
                  "    pm.expect(j.id).to.eql(storedOrderId);",
                  "    pm.expect(j.status).to.eql('pending');",
                  "});",
                  "pm.test('[RDS-ORDER-2] Order data matches what was stored', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.customer_name).to.eql('Anna Kowalska');",
                  "    pm.expect(j.quantity).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{order_service_url}}/orders/{{order_id}}"
          }
        },
        {
          "name": "RDS-ORDER-3 List all orders (verify RDS query)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RDS-ORDER-3] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[RDS-ORDER-3] Returns array of orders from RDS', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.be.an('array');",
                  "    pm.expect(j.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('[RDS-ORDER-3] Created order appears in list', () => {",
                  "    const j = pm.response.json();",
                  "    const storedOrderId = pm.collectionVariables.get('order_id');",
                  "    const found = j.find(o => o.id === storedOrderId);",
                  "    pm.expect(found).to.exist;",
                  "    pm.expect(found.status).to.eql('pending');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{order_service_url}}/orders/"
          }
        }
      ]
    },
    {
      "name": "3. AWS RDS — InventoryService (PostgreSQL)",
      "item": [
        {
          "name": "RDS-INV-1 Get all ingredients (verify RDS seeded data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[RDS-INV-1] Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('[RDS-INV-1] Returns ingredients array from RDS', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.be.an('array');",
                  "    pm.expect(j.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('[RDS-INV-1] Contains seeded ingredients (mąka, cukier, masło, jajka, śmietana)', () => {",
                  "    const j = pm.response.json();",
                  "    const names = j.map(i => i.name);",
                  "    pm.expect(names).to.include('mąka');",
                  "    pm.expect(names).to.include('cukier');",
                  "    pm.expect(names).to.include('masło');",
                  "    pm.expect(names).to.include('jajka');",
                  "    pm.expect(names).to.include('śmietana');",
                  "});",
                  "pm.test('[RDS-INV-1] Each ingredient has id, name, quantity, unit, updated_at', () => {",
                  "    const j = pm.response.json();",
                  "    j.forEach(ing => {",
                  "        pm.expect(ing).to.have.all.keys('id', 'name', 'quantity', 'unit', 'updated_at');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{inventory_service_url}}/ingredients/"
          }
        },
        {
